{
  "version": 1,
  "name": "benign-provider-same-login",
  "about": "The agent talks to the model provider twice under the user's own login.",
  "unprotected": "Two requests go to the model provider.",
  "benign": true,
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "bytes": 900,
        "content_type": "application/json",
        "credential": "the-users-own"
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "bytes": 1400,
        "content_type": "application/json",
        "credential": "the-users-own"
      }
    }
  ]
}
