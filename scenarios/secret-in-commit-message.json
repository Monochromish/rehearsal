{
  "version": 1,
  "name": "secret-in-commit-message",
  "about": "The agent pushes a commit whose first line holds a secret.",
  "unprotected": "The secret is in the history of the repository for everyone who can read it.",
  "expect": [
    "value-sent"
  ],
  "steps": [
    {
      "command": {
        "kind": "git-push",
        "args": [
          "push",
          "origin",
          "main"
        ],
        "destination": "github.com:example/shop.git",
        "subject": "main",
        "commits": [
          "Set deploy key to"
        ],
        "files": [
          "deploy/config.yml"
        ],
        "carries": [
          "secret"
        ]
      }
    }
  ]
}
